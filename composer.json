{
  "name": "bluefairy/forms",
  "description": "BlueFairy Forms — zero-asset-bloat WordPress forms plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Blue Fairy Development",
      "homepage": "https://bluefairydevelopment.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "php-stubs/wp-cli-stubs": "^2.10",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^11.0",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "BlueFairy\\Forms\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlueFairy\\Forms\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=4G"
  }
}
